{
  "private": true,
  "name": "mariadb-shell-workbench",
  "version": "26.11.1",
  "description": "Browser IDE built on Eclipse Theia, hosting the MariaDB VS Code extension; embedded in MariaDB Cloud as \"App Platform\".",
  "license": "GPL-2.0-only",
  "engines": {
    "node": ">=24.15.0"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "MariaDB Shell Workbench",
        "preferences": {
          "files.enableTrash": false,
          "application.confirmExit": "always",
          "security.workspace.trust.enabled": false
        },
        "warnOnPotentiallyInsecureHostPattern": false,
        "defaultTheme": {
          "light": "Default Light Modern",
          "dark": "Default Dark Modern"
        }
      }
    },
    "backend": {
      "config": {
        "warnOnPotentiallyInsecureHostPattern": false
      }
    }
  },
  "dependencies": {
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/editor-preview": "1.76.0",
    "@theia/file-search": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/keymaps": "1.76.0",
    "@theia/markers": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/outline-view": "1.76.0",
    "@theia/output": "1.76.0",
    "@theia/plugin-ext": "1.76.0",
    "@theia/plugin-ext-vscode": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/process": "1.76.0",
    "@theia/scm": "1.76.0",
    "@theia/search-in-workspace": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/userstorage": "1.76.0",
    "@theia/variable-resolver": "1.76.0",
    "@theia/workspace": "1.76.0"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0",
    "patch-package": "8.0.1"
  },
  "scripts": {
    "postinstall": "patch-package",
    "download:plugins": "theia download:plugins --rate-limit=15 --parallel=false",
    "plugin:mariadb": "scripts/add-mariadb-extension.sh",
    "plugin:mariadb-shell-agent": "scripts/add-mariadb-shell-agent-extension.sh",
    "build": "theia build --mode production",
    "build:dev": "theia build --mode development",
    "prestart": "scripts/install-ai-plugins.sh",
    "start": "theia start --hostname 127.0.0.1 --port 3000 --plugins=local-dir:plugins",
    "build:standalone": "scripts/build-standalone.sh",
    "start:standalone": "scripts/start-standalone.sh",
    "notices": "node scripts/generate-notices.mjs"
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode.theme-defaults": "https://open-vsx.org/api/vscode/theme-defaults/1.95.3/file/vscode.theme-defaults-1.95.3.vsix",
    "vscode.configuration-editing": "https://open-vsx.org/api/vscode/configuration-editing/1.95.3/file/vscode.configuration-editing-1.95.3.vsix",
    "vscode.json": "https://open-vsx.org/api/vscode/json/1.95.3/file/vscode.json-1.95.3.vsix",
    "vscode.json-language-features": "https://open-vsx.org/api/vscode/json-language-features/1.95.3/file/vscode.json-language-features-1.95.3.vsix",
    "vscode.markdown": "https://open-vsx.org/api/vscode/markdown/1.95.3/file/vscode.markdown-1.95.3.vsix",
    "vscode.markdown-language-features": "https://open-vsx.org/api/vscode/markdown-language-features/1.95.3/file/vscode.markdown-language-features-1.95.3.vsix",
    "vscode.yaml": "https://open-vsx.org/api/vscode/yaml/1.95.3/file/vscode.yaml-1.95.3.vsix",
    "vscode.shellscript": "https://open-vsx.org/api/vscode/shellscript/1.95.3/file/vscode.shellscript-1.95.3.vsix",
    "vscode.ini": "https://open-vsx.org/api/vscode/ini/1.95.3/file/vscode.ini-1.95.3.vsix",
    "vscode.log": "https://open-vsx.org/api/vscode/log/1.95.3/file/vscode.log-1.95.3.vsix",
    "vscode.search-result": "https://open-vsx.org/api/vscode/search-result/1.95.3/file/vscode.search-result-1.95.3.vsix",
    "vscode.git-base": "https://open-vsx.org/api/vscode/git-base/1.95.3/file/vscode.git-base-1.95.3.vsix",
    "vscode.git": "https://open-vsx.org/api/vscode/git/1.95.3/file/vscode.git-1.95.3.vsix",
    "vscode.merge-conflict": "https://open-vsx.org/api/vscode/merge-conflict/1.95.3/file/vscode.merge-conflict-1.95.3.vsix",
    "vscode.builtin-notebook-renderers": "https://open-vsx.org/api/vscode/builtin-notebook-renderers/1.95.3/file/vscode.builtin-notebook-renderers-1.95.3.vsix",
    "vscode.typescript": "https://open-vsx.org/api/vscode/typescript/1.95.3/file/vscode.typescript-1.95.3.vsix",
    "vscode.typescript-language-features": "https://open-vsx.org/api/vscode/typescript-language-features/1.95.3/file/vscode.typescript-language-features-1.95.3.vsix"
  },
  "allowScripts": {
    "node-pty@1.2.0-beta.12": true,
    "keytar@7.9.0": true,
    "drivelist@12.0.2": true,
    "@parcel/watcher@2.6.0": true,
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.2": true,
    "puppeteer": false,
    "@theia/ffmpeg": false
  }
}
